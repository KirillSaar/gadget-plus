            "{{login_path}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@shop.kz\",\n  \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "const t = j.token || (j.data && j.data.token) || j.access_token;",
              "pm.collectionVariables.set('token_admin', t);"
